###############################################################################
# Konfigurasi aplikasi
#
# Salin berkas ini menjadi .env lalu isi nilainya sesuai lingkungan Anda.
# Berkas .env TIDAK BOLEH ikut ter-commit — sudah didaftarkan di .gitignore.
#
# Bangkitkan APP_KEY dengan:  php artisan key:generate
###############################################################################

APP_NAME="Phone Repair"

# local | production. Di server gunakan "production".
APP_ENV=local

APP_KEY=

# WAJIB false di server. Bila true, halaman galat menampilkan isi .env,
# jejak stack, dan potongan query database kepada siapa pun yang membukanya.
APP_DEBUG=true

APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

# Jumlah putaran bcrypt. 12 adalah titik seimbang antara keamanan dan kecepatan.
BCRYPT_ROUNDS=12

###############################################################################
# Log
###############################################################################

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null

# Gunakan "error" di production agar isi request tidak tercatat berlebihan.
LOG_LEVEL=debug

###############################################################################
# Database
#
# Jangan memakai akun root. Buat pengguna khusus yang hanya diberi hak pada
# database aplikasi ini:
#
#   CREATE DATABASE servis_app CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'servis_app'@'127.0.0.1' IDENTIFIED BY 'kata-sandi-panjang-acak';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON servis_app.* TO 'servis_app'@'127.0.0.1';
#   FLUSH PRIVILEGES;
#
# Hak DDL (CREATE/ALTER/DROP) cukup diberikan sementara saat menjalankan
# migrasi, lalu dicabut kembali.
#
# Pastikan pula port 3306 tidak terbuka ke internet — batasi ke localhost
# atau ke alamat IP server aplikasi saja.
###############################################################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=servis_app
DB_USERNAME=
DB_PASSWORD=

###############################################################################
# Sesi
###############################################################################

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Isi data sesi ikut dienkripsi di penyimpanan.
SESSION_ENCRYPT=true

SESSION_PATH=/
SESSION_DOMAIN=null

# WAJIB true di server ber-HTTPS: cookie sesi tidak akan dikirim lewat
# koneksi http polos sehingga tidak bisa disadap di jaringan publik.
SESSION_SECURE_COOKIE=false

SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

###############################################################################
# Autentikasi
#
# Aplikasi ini hanya untuk staf internal, jadi pendaftaran mandiri ditutup.
# Buat akun lewat:  php artisan user:create
#
# Nyalakan sementara (true) hanya bila memang dibutuhkan, misalnya saat
# mendemonstrasikan sistem.
###############################################################################

AUTH_REGISTRATION_ENABLED=false
AUTH_REGISTRATION_ROLE=admin

# Dipakai DatabaseSeeder. Bila dikosongkan, seeder membangkitkan kata sandi
# acak dan menampilkannya sekali di terminal.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

###############################################################################
# SEO — identitas usaha untuk meta tag dan structured data
#
# Kolom alamat dan telepon boleh dikosongkan; yang kosong tidak akan ikut
# ditulis ke JSON-LD, sehingga tidak ada data karangan yang dikirim ke
# mesin pencari.
###############################################################################

SEO_SITE_NAME="Phone Repair"
SEO_TITLE="Sistem Pengelolaan Layanan Servis Smartphone"
SEO_DESCRIPTION=
SEO_KEYWORDS=
SEO_TELEPHONE=
SEO_STREET=
SEO_CITY=
SEO_REGION=
SEO_POSTAL=
SEO_COUNTRY=ID
SEO_OPENING_HOURS=

###############################################################################
# Antrean, cache, dan berkas
###############################################################################

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

###############################################################################
# Surel — dipakai untuk tautan atur ulang kata sandi
###############################################################################

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@phonerepair.test"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# Penyimpanan objek (opsional)
###############################################################################

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
